# Copy to .env and fill in values from your X Developer Portal app.
# Use the same OAuth 2.0 app as Pickems/Features/Sharing/Utilities/AppConfig.swift.
#
# MCP bridge (Cursor): register redirect URI http://localhost:8080/callback
# iOS app OAuth: register redirect URI pickems://x-callback
#
# Docs: https://docs.x.com/tools/mcp

CLIENT_ID=your_x_app_client_id
CLIENT_SECRET=your_x_app_client_secret
