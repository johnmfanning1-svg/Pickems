# Pickems admin portal — Vite environment template.
#
# Local overrides: copy to .env.local (gitignored).
# Production Hosting builds use committed `.env.production` (same values).
#
# Source of truth for the *web* app:
#   firebase apps:sdkconfig WEB --project pickems-fb
#
# Do NOT hand-copy values out of GoogleService-Info.plist — the iOS and web
# apps are different Firebase apps with different appIds and API keys.
#
# None of these are secrets (Hosting serves them in a public bundle).
# Firestore rules (`isSuperAdmin()`) are the actual security boundary.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pickems-fb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pickems-fb
VITE_FIREBASE_STORAGE_BUCKET=pickems-fb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — Google Analytics measurement id. Leave blank to skip analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# Set to "true" to point auth/firestore/functions at the local emulators
# (`firebase emulators:start` from firebase/). Never set this in a deployed build.
VITE_USE_EMULATORS=false

# Callable functions region. Must match the deployed region of
# functions/src/admin.ts — v2 onCall defaults to us-central1.
VITE_FUNCTIONS_REGION=us-central1

# Shown in the header so nobody edits prod thinking it is staging.
VITE_ENVIRONMENT_LABEL=production
