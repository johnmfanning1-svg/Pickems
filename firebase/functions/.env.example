# Private support delivery — copy to .env.pickems-fb (gitignored) or set
# in Google Cloud Console → Cloud Functions → submitSupport → Runtime env.
# Never put the real inbox address in HTML, git, or appConfig/live.

# Gmail (or any inbox) used only by the Cloud Function to forward FormSubmit mail.
SUPPORT_INBOX_EMAIL=

# Optional. Preferred mail path when set — the access key is not an email address.
SUPPORT_WEB3FORMS_ACCESS_KEY=
