{
  "name": "pickems-functions",
  "description": "Pickems Cloud Functions — slate lock, scoring, push, season close",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/node-fetch": "^2.6.11",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "private": true
}
