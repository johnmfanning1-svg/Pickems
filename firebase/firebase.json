{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "admin/dist",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/login",
        "destination": "/admin/login",
        "type": 301
      },
      {
        "source": "/groups",
        "destination": "/admin/groups",
        "type": 301
      },
      {
        "source": "/groups/**",
        "destination": "/admin/groups/:splat",
        "type": 301
      },
      {
        "source": "/config",
        "destination": "/admin/config",
        "type": 301
      },
      {
        "source": "/support-inbox",
        "destination": "/admin/support-inbox",
        "type": 301
      },
      {
        "source": "/audit/**",
        "destination": "/admin/audit/:splat",
        "type": 301
      },
      {
        "source": "/moderation",
        "destination": "/admin/moderation",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/join",
        "destination": "/join.html"
      },
      {
        "source": "/join/**",
        "destination": "/join.html"
      },
      {
        "source": "/support",
        "destination": "/support.html"
      },
      {
        "source": "/support/**",
        "destination": "/support.html"
      },
      {
        "source": "/api/support",
        "function": {
          "functionId": "submitSupport",
          "region": "us-central1"
        }
      },
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      }
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/admin/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/support.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "predeploy": [
      "bash scripts/stage-hosting.sh"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
