rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Super-user privilege lives in the Auth ID token, not in a Firestore doc:
    // it costs zero reads and no client write can ever grant it.
    // Granted with firebase/admin-tools/set-admin.mjs or the setAdminRole callable.
    // A missing `admin` claim must be false. Reading the key directly throws
    // ("Property admin is undefined"), and that error is an evaluation by itself.
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Super admins are commissioner-equivalent everywhere. The claim check is
    // first so it short-circuits before the group get() — that keeps admin
    // access working even when the group doc is missing or already deleted.
    function isCommissioner(groupId) {
      return isSignedIn()
        && (isSuperAdmin()
            || get(/databases/$(database)/documents/groups/$(groupId)).data.commissionerId == request.auth.uid);
    }

    // Self-join is not "know the group id". The client first writes
    // `joinTickets/{uid}` with the invite code (see validJoinProof). That
    // ticket is the only way a non-member may add themselves to memberIds.
    // Commissioner-only invites are a share-sheet setting, not a join gate:
    // anyone with the current code can join, including someone who was removed.
    function isJoiningGroup(groupId) {
      // Shape checks first so a leave (or any other update) never get()s a
      // missing ticket. A failed get() would deny the whole OR.
      return isSignedIn()
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && freshJoinTicket(groupId);
    }

    function freshJoinTicket(groupId) {
      let ticket = get(/databases/$(database)/documents/groups/$(groupId)/joinTickets/$(request.auth.uid)).data;
      return ticket.code == resource.data.inviteCode
        && ticket.createdAt is timestamp
        && request.time < ticket.createdAt + duration.value(10, 'm')
        && get(/databases/$(database)/documents/inviteCodes/$(ticket.code)).data.groupId == groupId;
    }

    // Proof the caller knows the league's current code. Group docs are not
    // readable before membership, so the code cannot be copied off the group.
    function validJoinProof(groupId) {
      let data = request.resource.data;
      let code = data.code;
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return data.keys().hasOnly(['code', 'createdAt'])
        && code is string
        && code.matches('^[A-Z0-9]{4,8}$')
        && data.createdAt == request.time
        && !(request.auth.uid in group.memberIds)
        && code == group.inviteCode
        && get(/databases/$(database)/documents/inviteCodes/$(code)).data.groupId == groupId;
    }

    function isLeavingGroup() {
      return request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && request.auth.uid in resource.data.memberIds
        && !(request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
    }

    // Group read only after a non-rolling deadline has actually passed.
    // `&&` skips this on the common "still before kickoff" path.
    function allowLatePicks(groupId) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return group.keys().hasAll(['rules'])
        && group.rules.keys().hasAll(['allowLatePicks'])
        && group.rules.allowLatePicks == true;
    }

    // Week lock shared with pick selections. A started game stays locked even
    // when this is false — see gameDataOpen / gameOpen.
    function weekLevelLocked(groupId, week) {
      return week.status in ['locked', 'scored']
        || (week.keys().hasAll(['remainingLockAt'])
            && week.remainingLockAt != null
            && request.time >= week.remainingLockAt)
        || (isRollingWeek(week)
            && week.keys().hasAll(['weekLockAt'])
            && week.weekLockAt != null
            && request.time >= week.weekLockAt)
        || (!isRollingWeek(week)
            && week.keys().hasAll(['pickDeadline'])
            && week.pickDeadline != null
            && request.time >= week.pickDeadline
            && !allowLatePicks(groupId));
    }

    // `scheduled` is the stored name for ESPN `pre`.
    function gameDataOpen(data) {
      return (!data.keys().hasAll(['kickoff'])
          || data.kickoff == null
          || (data.kickoff is timestamp && request.time < data.kickoff))
        && (!data.keys().hasAll(['status'])
          || data.status == null
          || data.status == 'pre'
          || data.status == 'scheduled');
    }

    function liveSpreadKeysOnly(changed) {
      return changed.hasOnly(['liveSpread', 'liveSpreadTeamId'])
        || changed.hasOnly(['liveSpread'])
        || changed.hasOnly(['liveSpreadTeamId']);
    }

    // Clients may edit the league line, and may clear a stale lockedSpread,
    // but only functions may set lockedSpread.
    function leagueSpreadKeysOnly(changed) {
      return changed.hasOnly(['spread', 'spreadTeamId', 'lockedSpread', 'lockedSpreadTeamId'])
        && changed.hasAny(['spread', 'spreadTeamId'])
        && !('lockedSpread' in request.resource.data)
        && !('lockedSpreadTeamId' in request.resource.data);
    }

    function spreadEditable(groupId, weekId) {
      let week = weekData(groupId, weekId);
      return !weekLevelLocked(groupId, week) && gameDataOpen(resource.data);
    }

    function commissionerGameUpdate(groupId, weekId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return liveSpreadKeysOnly(changed)
        || (leagueSpreadKeysOnly(changed) && spreadEditable(groupId, weekId));
    }

    function superAdminGameUpdate(groupId, weekId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let graded = changed.hasAny(['spread', 'spreadTeamId', 'lockedSpread', 'lockedSpreadTeamId']);
      return !graded || (leagueSpreadKeysOnly(changed) && spreadEditable(groupId, weekId));
    }

    function lockSnapshotKeys() {
      return ['pickLockMode', 'weekLockAt', 'gameIds', 'gameKickoffs', 'remainingLockAt'].toSet();
    }

    // Do not subtract lockSnapshotKeys() here. An empty diff passes hasOnly(),
    // so ignoring those keys let a member rewrite the snapshot and keep picking
    // after kickoff. Members only maintain the nomination counter. Opening
    // picking (and writing the snapshot) is the commissioner client or a
    // Cloud Function (Admin SDK bypasses these rules).
    function memberWeekFieldUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      // hasAny() takes a list. lockSnapshotKeys() is a set for difference().
      return changed.hasOnly(['nominationCount'])
        && !changed.hasAny(['pickLockMode', 'weekLockAt', 'gameIds', 'gameKickoffs', 'remainingLockAt']);
    }

    // Members mint missing week docs from the calendar. They must not mint an
    // open picking week or stamp a lock snapshot / pickDeadline of their own.
    // Week 0 is the fixed-slate exception the app creates already in `picking`.
    function memberWeekCreate(weekId) {
      let data = request.resource.data;
      return data.nominationCount == 0
        && !data.keys().hasAny(['pickLockMode', 'weekLockAt', 'gameIds', 'gameKickoffs', 'remainingLockAt', 'pickDeadline'])
        && (
          data.status == 'selection'
          || (data.status == 'picking'
              && weekId.matches('^[0-9]{4}-W0$')
              && data.weekNumber == 0
              && data.slateSource == 'fixedBoard')
        );
    }

    // Create is the delete-and-recreate hole around the update allow-list.
    // Season counters stay 0; Cloud Functions (Admin SDK) are what increment them.
    function memberSelfCreate(groupId, memberId) {
      let data = request.resource.data;
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return request.auth.uid == memberId
        && request.auth.uid in group.memberIds
        && data.keys().hasOnly([
          'id',
          'displayName',
          'avatarColorHex',
          'avatarImageURL',
          'role',
          'joinedAt',
          'seasonWins',
          'seasonLosses'
        ])
        && data.id == memberId
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 20
        && data.avatarColorHex is string
        && data.avatarColorHex.size() > 0
        && data.avatarColorHex.size() <= 9
        && (!data.keys().hasAny(['avatarImageURL']) || data.avatarImageURL is string)
        // Server time, or a client clock a few minutes off. Not a 1970 backdate.
        && data.joinedAt is timestamp
        && data.joinedAt >= request.time - duration.value(10, 'm')
        && data.joinedAt <= request.time + duration.value(10, 'm')
        && data.seasonWins == 0
        && data.seasonLosses == 0
        && (
          (data.role == 'member' && group.commissionerId != request.auth.uid)
          || (data.role == 'commissioner' && group.commissionerId == request.auth.uid)
        );
    }

    // Lock-snapshot keys are omitted from this allow-list on purpose: the
    // commissioner client writes them when it opens picking, freezes remaining
    // games, or seeds Week 0. Members do not get this subtraction — see
    // memberWeekFieldUpdate. Cloud Functions write the same fields via the Admin SDK.
    function commissionerWeekFieldUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys()
        .difference(lockSnapshotKeys());
      return changed.size() == 0
        || changed.hasOnly(['nominationCount'])
        || changed.hasOnly(['status', 'nominationCount'])
        || changed.hasOnly(['status', 'nominationCount', 'pickDeadline'])
        || changed.hasOnly(['status', 'pickDeadline'])
        || changed.hasOnly(['status', 'lockedAt'])
        || changed.hasOnly(['status', 'lockedAt', 'pickDeadline'])
        || changed.hasOnly(['status', 'nominationCount', 'pickDeadline', 'lockedAt'])
        // Reopen Selections: status-only when lockedAt was never stamped.
        || changed.hasOnly(['status'])
        // Extend / repair pick deadline without changing week status.
        || changed.hasOnly(['pickDeadline'])
        || changed.hasOnly(['selectionDeadline', 'selectionDeadlineSetAt', 'selectionDeadlineSetBy'])
        || changed.hasOnly(['selectionDeadline', 'selectionDeadlineSetAt', 'selectionDeadlineSetBy', 'selectionDeadlinePassedNotified'])
        || (changed.hasOnly(['slateSize', 'selectionMode', 'selectionsPerMember'])
            && resource.data.status == 'selection')
        // This week's commissioner Override ranking among equal records.
        || changed.hasOnly(['tieBreakOrder'])
        // Commissioner per-week scoring mode. Locked/scored weeks stay frozen.
        || (changed.hasOnly(['pickMode'])
            && resource.data.status in ['selection', 'picking']);
    }

    function weekData(groupId, weekId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/weeks/$(weekId)).data;
    }

    function selectionDeadlineOpen(week) {
      return !('selectionDeadline' in week)
        || week.selectionDeadline == null
        || request.time < week.selectionDeadline;
    }

    function nominationMemberMayEdit(groupId, weekId) {
      let week = weekData(groupId, weekId);
      return week.status == 'selection' && selectionDeadlineOpen(week);
    }

    // Week status first so a non-selection week does not also read the group.
    // Own-submission is checked before the group read; commissioners fall through.
    function nominationCreateAllowed(groupId, weekId) {
      let week = weekData(groupId, weekId);
      return week.status == 'selection'
        && ((request.resource.data.submittedBy == request.auth.uid
            && isGroupMember(groupId)
            && selectionDeadlineOpen(week))
          || isCommissioner(groupId));
    }

    // Nomination docs carry the ESPN kickoff the client is saving. Creates,
    // and updates that point a Selection at a different game, must be strictly
    // before that kickoff. A missing kickoff is rejected. This does not
    // rewrite selections already saved.
    function selectionKickoffStillAhead() {
      return request.resource.data.keys().hasAll(['kickoff'])
        && request.resource.data.kickoff is timestamp
        && request.time < request.resource.data.kickoff;
    }

    function selectionKeepsGameOrKickoffAhead() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['espnEventId'])
        || selectionKickoffStillAhead();
    }

    function groupRules(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.get('rules', {});
    }

    // Missing `vetoEnabled` is off. Commissioner mode never takes veto votes.
    function vetoFeatureOn(groupId) {
      return groupRules(groupId).get('vetoEnabled', false) == true;
    }

    function memberSelectionMode(groupId, week) {
      let groupMode = groupRules(groupId).get('selectionMode', 'member');
      let weekMode = week.get('selectionMode', groupMode);
      return groupMode == 'member' && weekMode == 'member';
    }

    // Selections open: member mode, status `selection`, deadline still ahead.
    function selectionVetoWindow(groupId, weekId) {
      let week = weekData(groupId, weekId);
      return vetoFeatureOn(groupId)
        && memberSelectionMode(groupId, week)
        && week.status == 'selection'
        && selectionDeadlineOpen(week);
    }

    function nominationParent(groupId, weekId, nominationId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/weeks/$(weekId)/nominations/$(nominationId)).data;
    }

    // One vote per member, not the selector, only while Selections are open
    // and strictly before that game's kickoff. Votes are create-only.
    function selectionVetoVoteCreate(groupId, weekId, nominationId, voterId) {
      let nomination = nominationParent(groupId, weekId, nominationId);
      let data = request.resource.data;
      return isSignedIn()
        && request.auth.uid == voterId
        && isGroupMember(groupId)
        && selectionVetoWindow(groupId, weekId)
        && nomination.keys().hasAll(['submittedBy', 'kickoff'])
        && nomination.submittedBy is string
        && nomination.submittedBy != voterId
        && nomination.kickoff is timestamp
        && request.time < nomination.kickoff
        && data.keys().hasOnly(['userId', 'createdAt'])
        && data.userId == voterId
        && data.createdAt == request.time;
    }

    // A recorded veto blocks that member from putting the same game back.
    // Commissioners (and super admins, via isCommissioner) can restore it.
    function memberVetoBlocksReselection(groupId, weekId) {
      let data = request.resource.data;
      return !isCommissioner(groupId)
        && data.keys().hasAll(['submittedBy', 'espnEventId'])
        && data.submittedBy is string
        && data.espnEventId is string
        && exists(/databases/$(database)/documents/groups/$(groupId)/weeks/$(weekId)/vetoes/$(data.submittedBy + '_' + data.espnEventId));
    }

    function picksVisibleToAll(groupId, weekId) {
      let week = weekData(groupId, weekId);
      return week.status in ['locked', 'scored']
        || (isRollingWeek(week) && weekFullyLocked(week))
        || (!isRollingWeek(week)
            && week.keys().hasAll(['pickDeadline'])
            && week.pickDeadline != null
            && request.time >= week.pickDeadline);
    }

    function isRollingWeek(week) {
      return week.keys().hasAll(['pickLockMode']) && week.pickLockMode == 'rolling';
    }

    function remainingFrozen(week) {
      return week.keys().hasAll(['remainingLockAt'])
        && week.remainingLockAt != null
        && request.time >= week.remainingLockAt;
    }

    function weekFullyLocked(week) {
      return remainingFrozen(week)
        || (week.keys().hasAll(['weekLockAt'])
            && week.weekLockAt != null
            && request.time >= week.weekLockAt);
    }

    // Tiebreaker id. Missing/empty is not a game. `liveIds` is the function's
    // non-pregame list; kickoff is compared here so a stored timestamp locks at
    // that instant, not on the next scoreboard pass.
    function confidenceStillOpen(kicks, liveIds, gameId) {
      return !(gameId is string)
        || gameId.size() == 0
        || (!liveIds.hasAny([gameId])
            && (!(gameId in kicks) || request.time < kicks[gameId]));
    }

    // Per-game locks from `gameLock/current` when that doc exists, else the week
    // snapshot (`mirror` is {} and `.get` falls through). Kickoff checks are
    // inlined: a function-per-slot re-evaluates into the 1,000-expression cap.
    // Phase is NOT walked per id — 20 of those comparisons exceed the cap on a
    // denial. Non-pregame ids are `liveIds` (one hasAny). Cap is 20 ids, same
    // as before; rules cannot loop.
    function pickSlateOpen(week, mirror, changed, newConfidence, oldConfidence) {
      let kicks = mirror.get('kickoffs', week.get('gameKickoffs', {}));
      let liveIds = mirror.get('liveIds', []);
      let ids = week.get('gameIds', []);
      return !changed.hasAny(liveIds)
        && (changed.size() == 0
            || ((ids.size() <= 0 || !changed.hasAny([ids[0]]) || !(ids[0] in kicks) || request.time < kicks[ids[0]])
          && (ids.size() <= 1 || !changed.hasAny([ids[1]]) || !(ids[1] in kicks) || request.time < kicks[ids[1]])
          && (ids.size() <= 2 || !changed.hasAny([ids[2]]) || !(ids[2] in kicks) || request.time < kicks[ids[2]])
          && (ids.size() <= 3 || !changed.hasAny([ids[3]]) || !(ids[3] in kicks) || request.time < kicks[ids[3]])
          && (ids.size() <= 4 || !changed.hasAny([ids[4]]) || !(ids[4] in kicks) || request.time < kicks[ids[4]])
          && (ids.size() <= 5 || !changed.hasAny([ids[5]]) || !(ids[5] in kicks) || request.time < kicks[ids[5]])
          && (ids.size() <= 6 || !changed.hasAny([ids[6]]) || !(ids[6] in kicks) || request.time < kicks[ids[6]])
          && (ids.size() <= 7 || !changed.hasAny([ids[7]]) || !(ids[7] in kicks) || request.time < kicks[ids[7]])
          && (ids.size() <= 8 || !changed.hasAny([ids[8]]) || !(ids[8] in kicks) || request.time < kicks[ids[8]])
          && (ids.size() <= 9 || !changed.hasAny([ids[9]]) || !(ids[9] in kicks) || request.time < kicks[ids[9]])
          && (ids.size() <= 10 || !changed.hasAny([ids[10]]) || !(ids[10] in kicks) || request.time < kicks[ids[10]])
          && (ids.size() <= 11 || !changed.hasAny([ids[11]]) || !(ids[11] in kicks) || request.time < kicks[ids[11]])
          && (ids.size() <= 12 || !changed.hasAny([ids[12]]) || !(ids[12] in kicks) || request.time < kicks[ids[12]])
          && (ids.size() <= 13 || !changed.hasAny([ids[13]]) || !(ids[13] in kicks) || request.time < kicks[ids[13]])
          && (ids.size() <= 14 || !changed.hasAny([ids[14]]) || !(ids[14] in kicks) || request.time < kicks[ids[14]])
          && (ids.size() <= 15 || !changed.hasAny([ids[15]]) || !(ids[15] in kicks) || request.time < kicks[ids[15]])
          && (ids.size() <= 16 || !changed.hasAny([ids[16]]) || !(ids[16] in kicks) || request.time < kicks[ids[16]])
          && (ids.size() <= 17 || !changed.hasAny([ids[17]]) || !(ids[17] in kicks) || request.time < kicks[ids[17]])
          && (ids.size() <= 18 || !changed.hasAny([ids[18]]) || !(ids[18] in kicks) || request.time < kicks[ids[18]])
          && (ids.size() <= 19 || !changed.hasAny([ids[19]]) || !(ids[19] in kicks) || request.time < kicks[ids[19]])))
        && (newConfidence == oldConfidence
            || (confidenceStillOpen(kicks, liveIds, newConfidence)
                && confidenceStillOpen(kicks, liveIds, oldConfidence)));
    }

    // Own pick: lock flag can flip false→true once, with a submit time.
    // Commissioners writing someone else's sheet are not held to this.
    function memberLockShapeOk(isCreate) {
      return request.resource.data.isLocked == false
        || (request.resource.data.isLocked == true
            && request.resource.data.submittedAt != null
            && (isCreate || resource.data.isLocked == false));
    }

    // Cheap checks happen in pickWriteAllowed before this runs, so a signed-out
    // or badly shaped write never gets here. One group get, then one week get,
    // then the mirror.
    function pickWriteAuthorized(groupId, weekId, pickId, selfWrite, changed, newConfidence, oldConfidence) {
      let group = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let selfOk = selfWrite && request.auth.uid in group.memberIds;
      let commishOk = group.commissionerId == request.auth.uid && pickId in group.memberIds;
      let week = weekData(groupId, weekId);
      let windowOk = commishOk
        ? (week.status in ['selection', 'picking', 'locked'] && !weekLevelLocked(groupId, week))
        : (selfOk && week.status == 'picking' && !weekLevelLocked(groupId, week));
      let lockPath = /databases/$(database)/documents/groups/$(groupId)/weeks/$(weekId)/gameLock/current;
      let mirror = exists(lockPath) ? get(lockPath).data : {};
      return windowOk && pickSlateOpen(week, mirror, changed, newConfidence, oldConfidence);
    }

    function pickWriteAllowed(groupId, weekId, pickId, isCreate) {
      let selfWrite = isSignedIn() && request.auth.uid == pickId;
      let shapeOk = !selfWrite || memberLockShapeOk(isCreate);
      let data = request.resource.data;
      let changed = isCreate
        ? data.get('picks', {}).keys()
        : data.get('picks', {}).diff(resource.data.get('picks', {})).affectedKeys();
      let newConfidence = data.get('confidenceGameId', null);
      let oldConfidence = isCreate ? null : resource.data.get('confidenceGameId', null);
      return shapeOk
        && isSignedIn()
        && pickWriteAuthorized(groupId, weekId, pickId, selfWrite, changed, newConfidence, oldConfidence);
    }

    function memberPickDeleteOpen(groupId, weekId) {
      let week = weekData(groupId, weekId);
      return isRollingWeek(week)
        ? rollingPickDeleteOpen(week)
        : (week.status == 'picking'
            && ((!week.keys().hasAll(['pickDeadline'])
                || week.pickDeadline == null
                || request.time < week.pickDeadline)
              || allowLatePicks(groupId)));
    }

    function rollingPickDeleteOpen(week) {
      return week.status == 'picking'
        && !remainingFrozen(week)
        && (!week.keys().hasAll(['pickDeadline'])
            || week.pickDeadline == null
            || request.time < week.pickDeadline);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Unique nickname / handle reservations (doc id = lowercase normalized display name).
    match /handles/{handleKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'displayName']);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /inviteCodes/{code} {
      // get by exact code for join; deny collection list so codes cannot be scraped.
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['groupId'])
        && isCommissioner(request.resource.data.groupId);
      allow delete: if isSignedIn()
        && isCommissioner(resource.data.groupId);
    }

    match /groups/{groupId} {
      // Non-members must not read inviteCode or the roster. Join looks up
      // inviteCodes/{code} (the code the user typed) and then writes a ticket.
      // `list` stays membership-scoped so the arrayContains query remains secure;
      // the admin portal needs an unscoped list, which only the claim grants.
      allow get: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.memberIds);
      allow list: if isSuperAdmin() || (isSignedIn() && request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn()
        && request.resource.data.commissionerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isCommissioner(groupId) || isJoiningGroup(groupId) || isLeavingGroup();
      // Commissioners write nested `rules` including `pickMode` (`ats` | `straightUp`).
      // Missing pickMode is treated as ats by iOS and Cloud Functions.
      // Per-week modes live on `weeks/{id}.pickMode` and win over the league value.
      // League type changes go through the `setLeaguePickMode` callable, which also
      // pins the old mode on locked/scored weeks (not writable by clients here).
      allow delete: if isCommissioner(groupId);

      match /members/{memberId} {
        allow read: if isGroupMember(groupId) || isSuperAdmin();
        allow create: if isSuperAdmin() || memberSelfCreate(groupId, memberId);
        allow update: if isCommissioner(groupId)
          || (isSignedIn()
              && request.auth.uid == memberId
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly([
                     'displayName',
                     'avatarColorHex',
                     'avatarImageURL',
                     'chatMuted',
                     'lastReadChatAt',
                     'notifySelectionDeadlines',
                     'notifyPickemsDeadlines',
                     'notifyGameFinals',
                     'notifyTookTheLead',
                     'notifyWeekScored',
                     'notifySeasonClosed',
                     'notifyChatMessages',
                     'notifyCommissionerDeadlines'
                   ]));
        // Self-delete only after the uid is already off memberIds (leave / kick).
        // Deleting while still a member was the season-record forge: recreate
        // the doc with seasonWins set. Commissioner delete still covers
        // dissolve-league, which removes docs before memberIds is cleared.
        allow delete: if isCommissioner(groupId)
          || (isSignedIn()
              && request.auth.uid == memberId
              && !(request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds));
      }

      // Short-lived proof that this uid typed the current invite code.
      match /joinTickets/{userId} {
        allow get: if isSignedIn() && (request.auth.uid == userId || isCommissioner(groupId));
        allow list: if isCommissioner(groupId);
        allow create, update: if isSignedIn()
          && request.auth.uid == userId
          && validJoinProof(groupId);
        allow delete: if isSignedIn() && (request.auth.uid == userId || isCommissioner(groupId));
      }

      match /weeks/{weekId} {
        allow read: if isGroupMember(groupId) || isSuperAdmin();
        allow create: if isCommissioner(groupId)
          || (isGroupMember(groupId) && memberWeekCreate(weekId));
        // Admins bypass the field-level allow-lists so the portal can repair
        // arbitrary week fields — that is the point of the portal.
        allow update: if isSuperAdmin()
          || (isCommissioner(groupId) && commissionerWeekFieldUpdate())
          || (isGroupMember(groupId) && memberWeekFieldUpdate());
        // Commissioner tears down week docs when dissolving a league (deleteGroup).
        allow delete: if isCommissioner(groupId);

        match /nominations/{nominationId} {
          allow read: if isGroupMember(groupId) || isSuperAdmin();
          // Kickoff is request data, so a past game is rejected before any get().
          // Members may only create their own Selections before the deadline.
          // Commissioners may create one for any member during selection
          // (including after the member deadline) but not after kickoff.
          // Super-admin creates stay exempt so the portal can repair history.
          allow create: if isSuperAdmin()
            || (isSignedIn()
                && selectionKickoffStillAhead()
                && nominationCreateAllowed(groupId, weekId)
                && !memberVetoBlocksReselection(groupId, weekId));
          allow update: if selectionKeepsGameOrKickoffAhead()
            && isSignedIn()
            && ((resource.data.submittedBy == request.auth.uid
                && nominationMemberMayEdit(groupId, weekId))
              || isCommissioner(groupId));
          allow delete: if isSignedIn()
            && ((resource.data.submittedBy == request.auth.uid
                && nominationMemberMayEdit(groupId, weekId))
              || isCommissioner(groupId));

          // Anonymous: a member can read only their own vote. The tally
          // lives on vetoTallies/{nominationId}, which everyone in the league
          // can read. Clients cannot change or retract a vote.
          match /vetoVotes/{voterId} {
            allow get: if isSignedIn() && request.auth.uid == voterId;
            allow list: if false;
            allow create: if selectionVetoVoteCreate(groupId, weekId, nominationId, voterId);
            allow update, delete: if false;
          }
        }

        // Written only by the veto function. Members can read the record
        // (matchup, count) but not the voter ids — those are not stored here.
        match /vetoes/{vetoId} {
          allow read: if isGroupMember(groupId) || isSuperAdmin();
          allow write: if false;
        }

        match /vetoTallies/{nominationId} {
          allow read: if isGroupMember(groupId) || isSuperAdmin();
          allow write: if false;
        }

        match /games/{gameId} {
          allow read: if isGroupMember(groupId) || isSuperAdmin();
          allow create, delete: if isCommissioner(groupId);
          allow update: if (isSuperAdmin() && superAdminGameUpdate(groupId, weekId))
            || (isCommissioner(groupId) && commissionerGameUpdate(groupId, weekId));
        }

        // Kickoff and phase copied from each game by lockAndScoreWeeks.
        // Clients cannot rewrite it to reopen a game that has already started.
        match /gameLock/{lockId} {
          allow read: if isGroupMember(groupId) || isSuperAdmin();
          allow write: if false;
        }

        match /picks/{pickId} {
          allow read: if isSuperAdmin()
            || isCommissioner(groupId)
            || (isGroupMember(groupId)
                && (pickId == request.auth.uid || picksVisibleToAll(groupId, weekId)));
          // Shape and auth run before group / week / gameLock reads.
          allow create: if isSuperAdmin()
            || pickWriteAllowed(groupId, weekId, pickId, true);
          allow update: if isSuperAdmin()
            || pickWriteAllowed(groupId, weekId, pickId, false);
          // Members can remove their own pick; commissioner clears picks on league teardown.
          allow delete: if isSignedIn()
            && ((request.auth.uid == pickId && memberPickDeleteOpen(groupId, weekId))
                || isCommissioner(groupId));
        }

        match /revealedPicks/{gameId} {
          allow read: if isGroupMember(groupId) || isSuperAdmin();
          allow write: if false;
        }

        match /submissions/{userId} {
          allow read: if isGroupMember(groupId) || isSuperAdmin();
          allow create, update: if isSuperAdmin()
            || (isCommissioner(groupId)
                && userId in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                && request.resource.data.userId == userId
                && !('picks' in request.resource.data))
            || (isSignedIn()
                && request.auth.uid == userId
                && isGroupMember(groupId)
                && request.resource.data.userId == userId
                && !('picks' in request.resource.data));
          allow delete: if isCommissioner(groupId)
            || (isSignedIn() && request.auth.uid == userId);
        }

        // Lead-alert dedupe. lockAndScoreWeeks writes these with the Admin SDK
        // (which bypasses rules) before sending "You took the lead". Clients
        // must not read or forge a claim.
        match /leadAlerts/{userId} {
          allow read, write: if false;
        }
      }

      match /standings/{standingId} {
        allow read: if isGroupMember(groupId) || isSuperAdmin();
        allow create, update: if isCommissioner(groupId);
        // Commissioner removes standings when dissolving a league (deleteGroup).
        allow delete: if isCommissioner(groupId);
      }

      match /seasons/{seasonId} {
        allow read: if isGroupMember(groupId) || isSuperAdmin();
        allow create, update: if isCommissioner(groupId);
        allow delete: if isCommissioner(groupId);
      }

      match /career/{userId} {
        allow read: if isGroupMember(groupId) || isSuperAdmin();
        allow create, update: if isCommissioner(groupId);
        allow delete: if isCommissioner(groupId);
      }

      // Group chat — one flat collection per group, optional weekId filter.
      // Needs the (weekId ASC, createdAt DESC) composite index.
      match /messages/{messageId} {
        allow read: if isGroupMember(groupId) || isSuperAdmin();

        // `createdAt == request.time` forces a serverTimestamp write, which is
        // what makes thread ordering untamperable. `reportCount == 0` pinned at
        // create plus its absence from every update allow-list means the
        // moderation counter can only ever move via a Cloud Function.
        allow create: if isGroupMember(groupId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.groupId == groupId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.isDeleted == false
          && request.resource.data.reportCount == 0
          && request.resource.data.createdAt == request.time;

        // Author edits own text / soft-deletes; any member may toggle reactions only.
        allow update: if isSuperAdmin()
          || (isGroupMember(groupId) && resource.data.userId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['text', 'editedAt', 'isDeleted']))
          || (isGroupMember(groupId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']))
          || (isCommissioner(groupId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted']));

        allow delete: if isCommissioner(groupId) || isSuperAdmin();

        match /reports/{reporterUid} {
          allow read: if isCommissioner(groupId) || isSuperAdmin();
          allow create: if isGroupMember(groupId) && request.auth.uid == reporterUid;
          allow update, delete: if isSuperAdmin();
        }
      }
    }

    match /publicLeagues/{groupId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isCommissioner(groupId);
    }

    // Remote kill switches and feature flags (appConfig/live). Every signed-in
    // client reads it at launch; only the portal writes it.
    match /appConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Private support inbox address and related ops config. Never put this on
    // appConfig/live — that document is readable by every signed-in member.
    match /adminConfig/{configId} {
      allow read, write: if isSuperAdmin();
    }

    // Public /support form writes go through the submitSupport Cloud Function
    // (Admin SDK). Clients cannot create rows; that would be a spam hole.
    match /supportMessages/{messageId} {
      allow read, delete: if isSuperAdmin();
      allow create, update: if false;
    }

    // Append-only trail of every privileged action. Callables write these with
    // the Admin SDK (which bypasses rules); the client path stays create-only.
    match /adminAudit/{entryId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Collection-group reads for the admin moderation queue. Nested
    // `match /groups/{groupId}/messages/{messageId}` does not apply to
    // collectionGroup("messages") queries — this recursive wildcard does.
    match /{path=**}/messages/{messageId} {
      allow read: if isSuperAdmin();
    }
  }
}
