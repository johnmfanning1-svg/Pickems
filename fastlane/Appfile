# App Store Connect identity for Pickems
# Prefer env vars in CI; local defaults match the shipping app.

app_identifier("FannypackInc.Pickems")

# Numeric Apple ID (App Store Connect → App Information)
apple_id(ENV["FASTLANE_APPLE_ID"] || "6785697079")

# Team IDs — set via env when running deliver/pilot
team_id(ENV["FASTLANE_TEAM_ID"]) if ENV["FASTLANE_TEAM_ID"]
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) if ENV["FASTLANE_ITC_TEAM_ID"]
